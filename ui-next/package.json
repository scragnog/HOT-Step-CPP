{
  "name": "ui-next",
  "license": "MIT",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.18.0 <25.0.0"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "validate": "node tools/validate-definitions.ts",
    "request": "node --no-warnings --import ./tools/real-app/load.mjs tools/compare-request.ts",
    "check": "tsc -p tsconfig.json && node tools/validate-definitions.ts && node --no-warnings --import ./tools/real-app/load.mjs tools/compare-request.ts",
    "docs": "node tools/validate-definitions.ts --docs",
    "fixtures": "node --no-warnings --import ./tools/real-app/load.mjs tools/make-fixtures.ts",
    "test": "node tools/test-validator.ts",
    "thumb": "node tools/thumb.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3"
  }
}
