# Copy to .env (gitignored) and fill in.

# Discord bot token — Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=

# Comma-separated Discord USER ids allowed to trigger the bot (right-click a
# user > Copy User ID, with Developer Mode enabled). Everyone else's pings are
# silently ignored; their messages still feed the context buffer.
ALLOWED_USER_IDS=

# Comma-separated CHANNEL ids the bot listens in (threads under an allowed
# channel are covered automatically).
ALLOWED_CHANNEL_IDS=

# Default model. Switch at runtime with !model fable|opus|sonnet|<full-id>.
CLAUDE_MODEL=claude-fable-5

# Optional overrides
# CLAUDE_BIN=claude
# Pings that may wait while the bot is mid-reply. Beyond this they get a 🚫
# and are dropped rather than answered long after the thread moved on.
# PING_QUEUE_MAX=5
# Discord messages fed to each invocation. Each ping is a fresh session, so
# this is the ONLY thing that governs how far back the bot can see. 200 costs
# ~12k tokens more per call than 30, which is noise against the fixed floor.
# CONTEXT_MESSAGES=200
# CLAUDE_TIMEOUT_MS=300000
