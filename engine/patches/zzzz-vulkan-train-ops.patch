+++ b/engine/ggml/src/ggml-vulkan/vulkan-shaders/fa_train_bwd_dq.comp
@@ -0,0 +1,74 @@
+#version 450
+
+// HOT-Step patch: flash-attn-train (Vulkan) — GGML_OP_FLASH_ATTN_TRAIN_BACK, pass A.
+// dQ for one query row per cluster, recomputing P from the forward's LSE:
+//   dS_ij = P_ij (dO_i . V_j - dO_i . O_i),  dQ_i = scale * sum_j dS_ij K_j
+
+#include "fa_train_common.glsl"
+
+layout(binding = 4) readonly buffer Fb { float f_d[]; };   // packed forward (O | LSE)
+layout(binding = 5) readonly buffer Gb { float g_d[]; };   // its gradient (dO | unused)
+layout(binding = 6) writeonly buffer Db { float d_d[]; };  // dQ | dK | dV
+
+void main() {
+    const uint lane = gl_LocalInvocationID.x;
+    const uint i    = p.row_base + gl_WorkGroupID.x*4 + gl_LocalInvocationID.y;
+    const uint h    = gl_WorkGroupID.y;
+    const uint b    = gl_WorkGroupID.z;
+    const uint E    = p.D/32;
+    const uint hk   = h/(p.Nh/p.Nkv);
+
+    // The two alignment gaps (dQ|dK and dK|dV), same rule as the forward.
+    if (i == 0 && h == 0 && b == 0) {
+        const uint n_q = p.D*p.S*p.Nh*p.B;
+        const uint n_k = p.D*p.S_kv*p.Nkv*p.B;
+        for (uint g = n_q + lane; g < p.dk_off; g += 32) d_d[p.d_off + g] = 0.0;
+        for (uint g = p.dk_off + n_k + lane; g < p.dv_off; g += 32) d_d[p.d_off + g] = 0.0;
+    }
+    if (i >= p.S) {
+        return;
+    }
+
+    float q[FA_MAXE], go[FA_MAXE], dq[FA_MAXE];
+    const uint qb = p.q_off + i*p.q_nb1 + h*p.q_nb2 + b*p.q_nb3;
+    const uint ob = p.D*(h + p.Nh*(i + p.S*b));
+    float di = 0.0;
+    [[unroll]] for (uint e = 0; e < FA_MAXE; ++e) {
+        q[e]  = e < E ? q_d[qb + lane + 32*e] : 0.0;
+        go[e] = e < E ? g_d[p.g_off + ob + lane + 32*e] : 0.0;
+        dq[e] = 0.0;
+        if (e < E) di += go[e]*f_d[p.f_off + ob + lane + 32*e];
+    }
+    di = fa_reduce(di);
+    const float lse = f_d[p.f_off + p.lse_off + h + p.Nh*(i + p.S*b)];
+
+    for (uint j = 0; j < p.S_kv; ++j) {
+        const float mv = fa_mask(h, b, i, j);
+        if (fa_is_neg_inf(mv)) {
+            continue;
+        }
+        const uint kb = p.k_off + j*p.k_nb1 + hk*p.k_nb2 + b*p.k_nb3;
+        float dot = 0.0;
+        [[unroll]] for (uint e = 0; e < FA_MAXE; ++e) {
+            if (e < E) dot += q[e]*k_d[kb + lane + 32*e];
+        }
+        const float pij = exp(p.scale*fa_reduce(dot) + mv - lse);
+        if (pij == 0.0) {
+            continue;
+        }
+        const uint vb = p.v_off + j*p.v_nb1 + hk*p.v_nb2 + b*p.v_nb3;
+        float dp = 0.0;
+        [[unroll]] for (uint e = 0; e < FA_MAXE; ++e) {
+            if (e < E) dp += go[e]*v_d[vb + lane + 32*e];
+        }
+        const float c = p.scale*pij*(fa_reduce(dp) - di);
+        [[unroll]] for (uint e = 0; e < FA_MAXE; ++e) {
+            if (e < E) dq[e] += c*k_d[kb + lane + 32*e];
+        }
+    }
+
+    const uint ob2 = p.d_off + p.D*(i + p.S*(h + p.Nh*b));
+    [[unroll]] for (uint e = 0; e < FA_MAXE; ++e) {
+        if (e < E) d_d[ob2 + lane + 32*e] = dq[e];
+    }
+}
diff --git a/engine/ggml/src/ggml-vulkan/vulkan-shaders/fa_train_common.glsl b/engine/ggml/src/ggml-vulkan/vulkan-shaders/fa_train_common.glsl
new file mode 100644
index 00000000..cb50c0c7
--- /dev/null
+++ b/engine/ggml/src/ggml-vulkan/vulkan-shaders/fa_train_common.glsl
@@ -0,0 +1,59 @@
+// HOT-Step patch: flash-attn-train (Vulkan). Shared by the three kernels.
+//
+// One 32-lane cluster per row (a query row for the forward and dQ, a key row
+// for dK/dV), four rows per workgroup. Lane l holds elements l, l+32, ... of
+// the D-wide vectors, so a dot product is a per-lane partial followed by a
+// shuffle-xor reduction that never leaves the cluster. Every branch taken
+// inside the row loop depends only on the row, so a cluster never diverges.
+//
+// Layouts match the CPU oracle (ggml-cpu/ops.cpp):
+//   q [D, S, Nh, B], k/v [D, S_kv, Nkv, B], strides in floats;
+//   mask [S_kv, S, m2, m3] f16, broadcast by modulo;
+//   packed forward: O [D, Nh, S, B] at 0, LSE [Nh, S, B] at lse_off;
+//   packed backward: dQ [D, S, Nh, B] at 0, dK at dk_off, dV at dv_off.
+
+#extension GL_EXT_control_flow_attributes : enable
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_shuffle : require
+
+#define FA_MAXE 8   // D <= 256
+
+layout(local_size_x = 32, local_size_y = 4, local_size_z = 1) in;
+
+layout(push_constant) uniform parameter {
+    uint D, S, Nh, B, S_kv, Nkv;
+    uint q_nb1, q_nb2, q_nb3;
+    uint k_nb1, k_nb2, k_nb3;
+    uint v_nb1, v_nb2, v_nb3;
+    uint m_ne0, m_ne1, m_ne2, m_ne3, has_mask;
+    float scale;
+    uint lse_off, dk_off, dv_off;
+    uint q_off, k_off, v_off, m_off, f_off, g_off, d_off;  // misalignment, in elements
+    uint row_base;  // first row of this dispatch: the host slices long ones
+} p;
+
+layout(binding = 0) readonly buffer Qb { float q_d[]; };
+layout(binding = 1) readonly buffer Kb { float k_d[]; };
+layout(binding = 2) readonly buffer Vb { float v_d[]; };
+layout(binding = 3) readonly buffer Mb { uint m_d[]; };   // f16 pairs
+
+float fa_reduce(float x) {
+    [[unroll]] for (uint s = 16; s > 0; s >>= 1) {
+        x += subgroupShuffleXor(x, s);
+    }
+    return x;
+}
+
+// Additive mask value for (head h, batch b, query i, key j); 0 without a mask.
+float fa_mask(uint h, uint b, uint i, uint j) {
+    if (p.has_mask == 0) {
+        return 0.0;
+    }
+    const uint idx = p.m_off + j + p.m_ne0*(i + p.m_ne1*((h % p.m_ne2) + p.m_ne2*(b % p.m_ne3)));
+    const vec2 pair = unpackHalf2x16(m_d[idx >> 1]);
+    return (idx & 1u) == 0u ? pair.x : pair.y;
+}
+
+bool fa_is_neg_inf(float x) {
+    return isinf(x) && x < 0.0;
+}
diff --git a/engine/ggml/src/ggml-vulkan/vulkan-shaders/fa_train_fwd.comp b/engine/ggml/src/ggml-vulkan/vulkan-shaders/fa_train_fwd.comp
new file mode 100644
index 00000000..56f28258
--- /dev/null
+++ b/engine/ggml/src/ggml-vulkan/vulkan-shaders/fa_train_fwd.comp
@@ -0,0 +1,69 @@
+#version 450
+
+// HOT-Step patch: flash-attn-train (Vulkan) — GGML_OP_FLASH_ATTN_TRAIN.
+// Online-softmax attention for one query row per cluster; writes O and the
+// row's log-sum-exp. A fully masked row yields O = 0, LSE = 0 (not NaN).
+
+#include "fa_train_common.glsl"
+
+layout(binding = 4) writeonly buffer Db { float d_d[]; };
+
+void main() {
+    const uint lane = gl_LocalInvocationID.x;
+    const uint i    = p.row_base + gl_WorkGroupID.x*4 + gl_LocalInvocationID.y;
+    const uint h    = gl_WorkGroupID.y;
+    const uint b    = gl_WorkGroupID.z;
+    const uint E    = p.D/32;
+    const uint hk   = h/(p.Nh/p.Nkv);
+
+    // The alignment gap between O and LSE: zero-width at every real geometry,
+    // but the packed tensor's gradient is scale(packed, 0) and 0 * NaN = NaN.
+    if (i == 0 && h == 0 && b == 0) {
+        const uint n_o = p.D*p.Nh*p.S*p.B;
+        for (uint g = n_o + lane; g < p.lse_off; g += 32) {
+            d_d[p.d_off + g] = 0.0;
+        }
+    }
+    if (i >= p.S) {
+        return;
+    }
+
+    float q[FA_MAXE], acc[FA_MAXE];
+    const uint qb = p.q_off + i*p.q_nb1 + h*p.q_nb2 + b*p.q_nb3;
+    [[unroll]] for (uint e = 0; e < FA_MAXE; ++e) {
+        q[e]   = e < E ? q_d[qb + lane + 32*e] : 0.0;
+        acc[e] = 0.0;
+    }
+    float m = -1.0/0.0, l = 0.0;
+
+    for (uint j = 0; j < p.S_kv; ++j) {
+        const float mv = fa_mask(h, b, i, j);
+        if (fa_is_neg_inf(mv)) {
+            continue;
+        }
+        const uint kb = p.k_off + j*p.k_nb1 + hk*p.k_nb2 + b*p.k_nb3;
+        float dot = 0.0;
+        [[unroll]] for (uint e = 0; e < FA_MAXE; ++e) {
+            if (e < E) dot += q[e]*k_d[kb + lane + 32*e];
+        }
+        const float s     = p.scale*fa_reduce(dot) + mv;
+        const float m_new = max(m, s);
+        const float corr  = exp(m - m_new);
+        const float pj    = exp(s - m_new);
+        l = l*corr + pj;
+        const uint vb = p.v_off + j*p.v_nb1 + hk*p.v_nb2 + b*p.v_nb3;
+        [[unroll]] for (uint e = 0; e < FA_MAXE; ++e) {
+            if (e < E) acc[e] = acc[e]*corr + pj*v_d[vb + lane + 32*e];
+        }
+        m = m_new;
+    }
+
+    const uint ob = p.d_off + p.D*(h + p.Nh*(i + p.S*b));
+    const float inv = l > 0.0 ? 1.0/l : 0.0;
+    [[unroll]] for (uint e = 0; e < FA_MAXE; ++e) {
+        if (e < E) d_d[ob + lane + 32*e] = acc[e]*inv;
+    }
+    if (lane == 0) {
+        d_d[p.d_off + p.lse_off + h + p.Nh*(i + p.S*b)] = l > 0.0 ? m + log(l) : 0.0;
+    }
+}
